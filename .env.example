# Sutherland Studio — environment variables
# Copy to `.env.local` for local dev. Set the same values in Vercel → Settings → Environment Variables for prod.

# Resend API key (https://resend.com/api-keys).
# Required for the booking form and newsletter signup to actually send mail.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Outbound "From" address. Must be on a Resend-verified domain.
# While you're still verifying sutherland.studio, you can temporarily use
# `Sutherland Studio <onboarding@resend.dev>` — but Resend will only deliver
# such test mail to the email tied to your Resend account.
MAIL_FROM="Sutherland Studio <bookings@sutherland.studio>"

# Internal inbox that receives booking notifications and newsletter signups.
# Defaults to the address in src/data/site.ts (hello@sutherland.studio) if unset.
MAIL_NOTIFY=hello@sutherland.studio
